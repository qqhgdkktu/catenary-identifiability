/-- A rational copy of the compartment balance, with the same column convention
as the real generator. The comparison theorem below checks that identification. -/
private def genQ (q : Fin 13 → ℚ) : Matrix (Fin 7) (Fin 7) ℚ := fun i j =>
  (∑ t : Fin 6,
    (q (fwd t) * (if j = t.castSucc then
      (if i = t.succ then 1 else 0) - (if i = t.castSucc then 1 else 0) else 0) +
     q (back t) * (if j = t.succ then
      (if i = t.castSucc then 1 else 0) - (if i = t.succ then 1 else 0) else 0)))
   - (if i = 4 ∧ j = 4 then q (loss 6) else 0)

private theorem gen_cast (q : Fin 13 → ℚ) :
    (Rat.castHom ℝ).mapMatrix (genQ q) =
      generator (m:=6) 4 (fun t => (q t : ℝ)) := by
  ext i j
  simp [RingHom.mapMatrix_apply,genQ,generator,directedEdge,apply_ite Rat.cast]

set_option maxRecDepth 100000 in
set_option maxHeartbeats 8000000 in
private theorem intertwines : intertwiner * genQ first = genQ second * intertwiner := by
  ext i j
  fin_cases i <;> fin_cases j <;> decide +kernel

private theorem input_fixed (j : Fin 7) :
    intertwiner j 0 = (1 : Matrix (Fin 7) (Fin 7) ℚ) j 0 := by
  fin_cases j <;> decide +kernel

private theorem observed_rows (v j : Fin 7) (hv : v = 2 ∨ v = 5 ∨ v = 6) :
    intertwiner v j = (1 : Matrix (Fin 7) (Fin 7) ℚ) v j := by
  rcases hv with rfl | rfl | rfl <;> fin_cases j <;> decide +kernel

/-- An intertwiner only needs to fix the input column and the observed rows. -/
private theorem power_entry {A B S : Mat 6} {i v : Fin 7}
    (hm : S*A = B*S)
    (hi : ∀ j, S j i = (1 : Mat 6) j i)
    (hv : ∀ j, S v j = (1 : Mat 6) v j) (p : ℕ) : (A^p) v i = (B^p) v i := by
  have comm (t : ℕ) : S*A^t = B^t*S := by
    induction t with
    | zero => simp
    | succ t ih => rw [pow_succ,pow_succ,← Matrix.mul_assoc,ih,Matrix.mul_assoc,hm,← Matrix.mul_assoc]
  have he := congrArg (fun M : Mat 6 => M v i) (comm p)
  simpa only [Matrix.mul_apply, hv, hi, Matrix.one_apply, ite_mul, mul_ite,
    one_mul, mul_one, zero_mul, mul_zero, Finset.sum_ite_eq, Finset.sum_ite_eq',
    Finset.mem_univ, if_true] using he

private theorem entry (v : Fin 7) (hv : v = 2 ∨ v = 5 ∨ v = 6) (p : ℕ) :
    (generator (m:=6) 4 (fun t => (first t : ℝ)) ^ p) v 0 =
      (generator (m:=6) 4 (fun t => (second t : ℝ)) ^ p) v 0 := by
  let φ : Matrix (Fin 7) (Fin 7) ℚ →+* Mat 6 := (Rat.castHom ℝ).mapMatrix
  apply power_entry (S:=φ intertwiner)
  · have h := congrArg φ intertwines
    rw [← gen_cast first, ← gen_cast second]
    simpa only [map_mul] using h
  · intro j
    exact (congrArg (Rat.castHom ℝ) (input_fixed j)).trans (by simp [Matrix.one_apply])
  · intro j
    exact (congrArg (Rat.castHom ℝ) (observed_rows v j hv)).trans (by simp [Matrix.one_apply])

/-- Two distinct positive physical models have the same three full output curves. -/
theorem named_collision :
    let a : Params 6 := fun t => (first t : ℝ)
    let b : Params 6 := fun t => (second t : ℝ)
    Positive a ∧ Positive b ∧ a (loss 6) ≠ b (loss 6) ∧
      SameCurves 0 2 6 4 a b ∧ SameCurves 0 5 6 4 a b := by
  let a : Params 6 := fun t => (first t : ℝ)
  let b : Params 6 := fun t => (second t : ℝ)
  have pos : ∀ i : Fin 13, 0 < first i ∧ 0 < second i := by decide +kernel
  have diff : first (loss 6) ≠ second (loss 6) := by decide +kernel
  refine ⟨fun i => by dsimp [a]; exact_mod_cast (pos i).1, fun i => by dsimp [b]; exact_mod_cast (pos i).2, ?_, ?_, ?_⟩
  · dsimp [a,b]
    exact_mod_cast diff
  · exact (sameCurves_iff_markov (m:=6) 0 2 6 4 a b).2
      ⟨entry 2 (by simp),entry 6 (by simp)⟩
  · exact (sameCurves_iff_markov (m:=6) 0 5 6 4 a b).2
      ⟨entry 5 (by simp),entry 6 (by simp)⟩

theorem physical_collision :
    ∃ a b : Params 6, Positive a ∧ Positive b ∧ a (loss 6) ≠ b (loss 6) ∧
      SameCurves 0 2 6 4 a b ∧ SameCurves 0 5 6 4 a b :=
  ⟨_,_,named_collision⟩

#print axioms physical_collision
end Catenary.ThirdSeven
